# ==========================================
# Python (Backend)
# ==========================================
# Virtual environments
.venv/
venv/
ENV/
env/

# Python byte-code / caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# React / Node.js (Frontend)
# ==========================================
# Dependency folder
node_modules/

# Production build artifacts
/dist/
/build/
out/

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js/ Remix caches if applicable
.next/
.cache/

# ==========================================
# Security & Environment Variables
# ==========================================
# Crucial: Never commit actual secret keys
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Allow committing an example file to show required setup keys
!.env.example

# ==========================================
# IDEs & System Files
# ==========================================
# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (PyCharm, WebStorm, etc.)
.idea/

# Operating System files
.DS_Store
Thumbs.db
